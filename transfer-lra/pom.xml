<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fr.simplex-software.workshop</groupId>
    <artifactId>quarkus-distributed-tx</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>transfer-lra</artifactId>
  <name>Quarkus Distributed TX :: the Saga (LRA) transfer module</name>
  <dependencies>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <!-- Note what is NOT here: account-repository. This service has no access to
         the accounts database and must go through the account service's API. That
         absence is the architectural difference from the XA module. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-narayana-lra</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.26.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>transfer-tck</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TEST SCOPE ONLY. The saga needs a real counterparty to talk to over HTTP,
         and the account service is it. Keeping this out of the main scope is what
         preserves the architecture: at runtime this service has no access to the
         accounts database, only to the account service's API. -->
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>account</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
